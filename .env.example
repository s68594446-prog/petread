# 复制为 .env 或直接 export。.env 已在 .gitignore 中,不要提交。
# config.yaml 里只写变量名,真实密钥只存在于环境变量中。

# --- 必填 ---
# 小米 MiMo API Key,对应 config.yaml 的 providers.omni.api_key_env
MIMO_API_KEY=

# --- 导出口令(强烈建议设置)---
# /export 导出全部设备的记录(校准用),用这个口令保护。
# 不设置时 /export 直接返回 503(禁用),不会裸奔。
EXPORT_KEY=

# --- 数据目录(部署持久化时设置)---
# SQLite 与上传文件都放这里。默认 ./data;Railway 等挂了 Volume 后设成挂载点。
# DATA_DIR=/data

# --- 可选:切回备选 provider 时才需要 ---
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=

# --- 可选:服务监听 ---
# PETREAD_PORT=7860
# PETREAD_RELOAD=1
